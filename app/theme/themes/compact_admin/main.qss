/* ============================================================
   ستايل لوحة تحكم عصرية نظيفة (مرجع العميل): شريط جانبي داكن +
   لون مميّز، كروت بيضاء دائرية بظل خفيف، جداول نظيفة، شارات حالة.
   ============================================================ */
* { font-family: "$font"; font-size: $base_size; outline: none; }
QWidget { background: $bg; color: $text; }
QLabel { background: transparent; }
QMainWindow, QDialog { background: $bg; }
QScrollArea { border: none; background: transparent; }
QScrollArea > QWidget > QWidget { background: transparent; }
#PageRoot, #BodyRoot, #Toolbar { background: transparent; }

/* ---- الشريط العلوي (أبيض نظيف) ---- */
#AppBar { background: $appbar_bg; border-bottom: 1px solid $border; }
#AppTitle { color: $appbar_text; font-size: 17px; font-weight: 800; }
#UserChip {
  background: $surface_alt; color: $appbar_text; border: 1px solid $border;
  border-radius: 18px; padding: 6px 14px; font-weight: 600;
}

/* ---- الشريط الجانبي (داكن) ---- */
#Sidebar { background: $sidebar_bg; border: none; }
#SidebarScroll, #SidebarScroll > QWidget > QWidget { background: transparent; }
#SidebarBrand {
  color: #FFFFFF; font-size: 15px; font-weight: 800; padding: 18px 16px 14px 16px;
}
#NavButton {
  text-align: right; padding: $nav_pad; border: none; border-radius: 10px;
  color: $sidebar_text; background: transparent; margin: 3px 12px; font-weight: 600;
}
#NavButton:hover { background: rgba(255,255,255,0.06); color: #FFFFFF; }
#NavButton:checked {
  background: $sidebar_active_bg; color: $sidebar_active_text; font-weight: 700;
}
#SidebarLogout {
  background: transparent; color: $sidebar_text;
  border: 1px solid rgba(255,255,255,0.22); border-radius: 10px;
  padding: 11px; font-weight: 700; margin: 8px 14px 14px 14px;
}
#SidebarLogout:hover { background: rgba(255,255,255,0.06); color: #FFFFFF; }

/* ---- الأزرار ---- */
QPushButton {
  background: $primary; color: $on_primary; border: none; border-radius: 10px;
  padding: $btn_pad; font-weight: 700;
}
QPushButton:hover { background: $primary_hover; }
QPushButton:pressed { background: $primary_dark; }
QPushButton:disabled { background: $surface_alt; color: $text_muted; }
QPushButton#Ghost { background: $surface; color: $text; border: 1px solid $border; }
QPushButton#Ghost:hover { background: $surface_alt; }
QPushButton#Accent { background: $accent; color: $on_accent; }
QPushButton#Danger { background: $danger; color: #FFFFFF; }
QPushButton#Success { background: $success; color: #FFFFFF; }
#AppBar QPushButton#Ghost { background: $surface; color: $text; border: 1px solid $border; }

/* ---- الحقول (دائرية ناعمة) ---- */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QPlainTextEdit, QTextEdit {
  background: $input_bg; border: 1px solid $border; border-radius: 10px; padding: $pad_v;
  color: $text; selection-background-color: $primary; selection-color: $on_primary;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus,
QPlainTextEdit:focus, QTextEdit:focus { border: 1px solid $primary; }
QComboBox::drop-down { border: none; width: 24px; }
QComboBox QAbstractItemView {
  background: $surface; border: 1px solid $border; border-radius: 8px; outline: none;
  selection-background-color: $primary; selection-color: $on_primary; padding: 4px;
}
QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button { width: 20px; }

/* ---- الكروت (بيضاء دائرية) ---- */
#Card { background: $surface; border: 1px solid $border; border-radius: 14px; }
#StatCard { background: $surface; border: 1px solid $border; border-radius: 14px; }
#StatValue { font-size: $stat_value_size; font-weight: 800; color: $text; }
#StatLabel { color: $text_muted; font-weight: 600; }
#StatHint { color: $text_muted; font-size: 12px; font-weight: 600; }
#StatChip { border-radius: 12px; font-size: 20px; }
#Title { font-size: $title_size; font-weight: 800; color: $text; }
#Heading { font-size: $heading_size; font-weight: 800; color: $text; }
#Muted { color: $text_muted; }

/* ---- الجداول (نظيفة بفواصل خفيفة) ---- */
QTableWidget, QTableView {
  background: $surface; border: 1px solid $border; border-radius: 12px;
  gridline-color: transparent; alternate-background-color: $surface;
}
QHeaderView::section {
  background: $surface; color: $text_muted; padding: 12px 10px; border: none;
  border-bottom: 1px solid $border; font-weight: 700;
}
QHeaderView::section:hover { color: $text; }
QTableWidget::item, QTableView::item { padding: 9px 6px; border-bottom: 1px solid $border; }
QTableWidget::item:selected, QTableView::item:selected { background: $surface_alt; color: $text; }
QTableCornerButton::section { background: $surface; border: none; }

/* ---- شارات الحالة ---- */
#PillSuccess { background: rgba(46,158,91,0.15);  color: $success; border-radius: 10px; padding: 4px 12px; font-weight: 700; }
#PillWarning { background: rgba(217,164,65,0.20);  color: #A87714; border-radius: 10px; padding: 4px 12px; font-weight: 700; }
#PillDanger  { background: rgba(224,88,79,0.15);   color: $danger;  border-radius: 10px; padding: 4px 12px; font-weight: 700; }
#PillMuted   { background: $surface_alt;            color: $text_muted; border-radius: 10px; padding: 4px 12px; font-weight: 700; }

/* ---- التبويبات ---- */
QTabWidget::pane { border: 1px solid $border; border-radius: 12px; top: -1px; background: $surface; }
QTabBar::tab {
  background: transparent; color: $text_muted; padding: 10px 20px; border: none;
  border-bottom: 2px solid transparent; margin-left: 4px; font-weight: 700;
}
QTabBar::tab:selected { color: $primary; border-bottom: 2px solid $primary; }

/* ---- أشرطة التمرير (رفيعة) ---- */
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: $border; border-radius: 5px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: $text_muted; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:horizontal { background: $border; border-radius: 5px; min-width: 30px; }
QScrollBar::handle:horizontal:hover { background: $text_muted; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

/* ---- متفرقات ---- */
QToolTip { background: $surface; color: $text; border: 1px solid $border; padding: 6px; border-radius: 8px; }
QCheckBox::indicator, QRadioButton::indicator { width: 18px; height: 18px; }
QCheckBox::indicator:checked { background: $primary; border-radius: 4px; }
QProgressBar { border: none; border-radius: 8px; background: $surface_alt; text-align: center; }
QProgressBar::chunk { background: $primary; border-radius: 8px; }
QMessageBox, QDialog { background: $surface; }
QMenu { background: $surface; color: $text; border: 1px solid $border; border-radius: 8px; padding: 4px; }
QMenu::item { padding: 7px 22px; border-radius: 6px; }
QMenu::item:selected { background: $primary; color: $on_primary; }

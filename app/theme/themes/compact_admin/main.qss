/* ============================================================
   هوية بصرية 2027 — قالب عصري بتدرّجات وأشكال (RC2-UI)
   كل الألوان والمقاسات تأتي من توكنز القالب ($token).
   ============================================================ */
* { font-family: "$font"; font-size: $base_size; outline: none; }
QWidget { color: $text; }
QMainWindow, QDialog {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 $bg, stop:1 $bg2);
}
QLabel { background: transparent; }            /* يمنع الصناديق فوق الأشرطة الملوّنة */
QScrollArea { border: none; background: transparent; }
QScrollArea > QWidget > QWidget { background: transparent; }
#PageRoot, #BodyRoot { background: transparent; }

/* ---- الشريط العلوي (تدرّج أفقي) ---- */
#AppBar {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 $appbar_bg, stop:1 $appbar_bg2);
  border: none; border-bottom: 1px solid rgba(0,0,0,0.10);
}
#AppTitle { color: $appbar_text; font-size: 19px; font-weight: 800; letter-spacing: 0.3px; }
#UserChip {
  background: rgba(255,255,255,0.16); color: $appbar_text;
  border: 1px solid rgba(255,255,255,0.30);
  border-radius: 16px; padding: 7px 16px; font-weight: 700;
}

/* ---- الشريط الجانبي (تدرّج رأسي) ---- */
#Sidebar {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 $sidebar_bg, stop:1 $sidebar_bg2);
  border: none;
}
#SidebarBrand {
  color: $sidebar_active_text; font-size: 16px; font-weight: 800;
  padding: 20px 14px 14px 14px; letter-spacing: 0.3px;
}
#NavButton {
  text-align: right; padding: $nav_pad; border: none; border-radius: $radius;
  color: $sidebar_text; background: transparent; margin: 3px 10px; font-weight: 600;
}
#NavButton:hover { background: rgba(255,255,255,0.10); color: $sidebar_active_text; }
#NavButton:checked {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
              stop:0 $sidebar_active_bg, stop:1 $accent);
  color: $sidebar_active_text; font-weight: 800;
}

/* ---- الأزرار (تدرّج + accent) ---- */
QPushButton {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 $primary, stop:1 $primary_dark);
  color: $on_primary; border: none; border-radius: $radius;
  padding: $btn_pad; font-weight: 700;
}
QPushButton:hover { background: $primary; }
QPushButton:pressed { background: $primary_dark; padding-top: 1px; }
QPushButton:disabled { background: $border; color: $text_muted; }
QPushButton#Ghost {
  background: transparent; color: $primary; border: 1.5px solid $primary;
}
QPushButton#Ghost:hover { background: $surface_alt; }
QPushButton#Accent {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 $accent, stop:1 $accent_dark);
  color: $on_accent;
}
QPushButton#Danger { background: $danger; color: #FFFFFF; }
QPushButton#Danger:hover { background: $danger; }
QPushButton#Success { background: $success; color: #FFFFFF; }

/* زر الخروج/الرجوع فوق الشريط العلوي الملوّن */
#AppBar QPushButton#Ghost {
  color: $appbar_text; border: 1.5px solid rgba(255,255,255,0.55); background: transparent;
}
#AppBar QPushButton#Ghost:hover { background: rgba(255,255,255,0.18); }

/* ---- الحقول ---- */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QPlainTextEdit, QTextEdit {
  background: $input_bg; border: 1.5px solid $border; border-radius: $radius; padding: $pad_v;
  color: $text; selection-background-color: $primary; selection-color: $on_primary;
}
QLineEdit:hover, QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover, QDateEdit:hover {
  border: 1.5px solid $accent;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus,
QPlainTextEdit:focus, QTextEdit:focus { border: 2px solid $primary; }
QComboBox::drop-down { border: none; width: 24px; }
QComboBox QAbstractItemView {
  background: $surface; border: 1px solid $border; border-radius: $radius; outline: none;
  selection-background-color: $primary; selection-color: $on_primary; padding: 4px;
}
QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button { width: 20px; }

/* ---- البطاقات والعناوين ---- */
#Card {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 $surface, stop:1 $surface_alt);
  border: 1px solid $border; border-radius: $radius_lg;
}
#StatCard {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 $surface, stop:1 $surface_alt);
  border: 1px solid $border; border-radius: $radius_lg;
  border-right: 4px solid $stat_accent;
}
#StatValue { font-size: $stat_value_size; font-weight: 800; color: $stat_accent; }
#StatLabel { color: $text_muted; font-weight: 700; }
#Title { font-size: $title_size; font-weight: 800; color: $text; }
#Heading { font-size: $heading_size; font-weight: 800; color: $text; }
#Muted { color: $text_muted; }
#SectionDot { color: $accent; font-weight: 900; }

/* ---- الجداول ---- */
QTableWidget, QTableView {
  background: $surface; border: 1px solid $border; border-radius: $radius;
  gridline-color: $border; alternate-background-color: $surface_alt;
}
QHeaderView::section {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 $surface_alt, stop:1 $surface);
  color: $text; padding: 11px; border: none; border-bottom: 2px solid $accent; font-weight: 800;
}
QHeaderView::section:hover { background: $primary; color: $on_primary; }
QTableWidget::item, QTableView::item { padding: 6px; }
QTableWidget::item:selected, QTableView::item:selected { background: $primary; color: $on_primary; }
QTableCornerButton::section { background: $surface_alt; border: none; }

/* ---- التبويبات ---- */
QTabWidget::pane { border: 1px solid $border; border-radius: $radius_lg; top: -1px; background: $surface; }
QTabBar::tab {
  background: $surface_alt; color: $text_muted; padding: 10px 22px;
  border-top-left-radius: $radius; border-top-right-radius: $radius; margin-left: 3px; font-weight: 700;
}
QTabBar::tab:selected {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 $primary, stop:1 $accent);
  color: $on_primary;
}

/* ---- أشرطة التمرير ---- */
QScrollBar:vertical { background: transparent; width: 13px; margin: 2px; }
QScrollBar::handle:vertical { background: $border; border-radius: 6px; min-height: 36px; }
QScrollBar::handle:vertical:hover { background: $accent; }
QScrollBar:horizontal { background: transparent; height: 13px; margin: 2px; }
QScrollBar::handle:horizontal { background: $border; border-radius: 6px; min-width: 36px; }
QScrollBar::handle:horizontal:hover { background: $accent; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

/* ---- متفرقات ---- */
QToolTip { background: $surface; color: $text; border: 1px solid $accent; padding: 6px; border-radius: 6px; }
QCheckBox::indicator, QRadioButton::indicator { width: 18px; height: 18px; }
QCheckBox::indicator:checked { background: $primary; border-radius: 4px; }
QProgressBar { border: 1px solid $border; border-radius: $radius; background: $surface_alt; text-align: center; }
QProgressBar::chunk {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 $primary, stop:1 $accent);
  border-radius: $radius;
}
QMessageBox, QDialog { background: $surface; }
QMenu { background: $surface; color: $text; border: 1px solid $border; border-radius: $radius; padding: 4px; }
QMenu::item { padding: 7px 22px; border-radius: 5px; }
QMenu::item:selected { background: $primary; color: $on_primary; }

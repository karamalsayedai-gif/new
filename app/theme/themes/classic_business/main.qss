/* ============================================================
   ستايل مينيمال نظيف + لمسة زجاجية (Glass) — RC3-UI
   كل الألوان والمقاسات من توكنز القالب ($token).
   ============================================================ */
* { font-family: "$font"; font-size: $base_size; outline: none; }
QWidget { color: $text; }
QMainWindow, QDialog {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 $bg, stop:1 $bg2);
}
QLabel { background: transparent; }
QScrollArea { border: none; background: transparent; }
QScrollArea > QWidget > QWidget { background: transparent; }
#PageRoot, #BodyRoot, #Toolbar { background: transparent; }

/* ---- الشريط العلوي (نظيف بلمسة هادئة) ---- */
#AppBar {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 $appbar_bg, stop:1 $appbar_bg2);
  border: none; border-bottom: 1px solid rgba(255,255,255,0.08);
}
#AppTitle { color: $appbar_text; font-size: 18px; font-weight: 700; letter-spacing: 0.2px; }
#UserChip {
  background: rgba(255,255,255,0.14); color: $appbar_text;
  border: 1px solid rgba(255,255,255,0.22);
  border-radius: 18px; padding: 7px 16px; font-weight: 600;
}

/* ---- الشريط الجانبي (مسطّح نظيف) ---- */
#Sidebar { background: $sidebar_bg; border: none; }
#SidebarScroll, #SidebarScroll > QWidget > QWidget { background: transparent; }
#SidebarBrand {
  color: $sidebar_active_text; font-size: 15px; font-weight: 700;
  padding: 18px 14px 12px 14px; letter-spacing: 0.2px;
}
#NavButton {
  text-align: right; padding: $nav_pad; border: none; border-radius: $radius;
  color: $sidebar_text; background: transparent; margin: 3px 10px; font-weight: 600;
}
#NavButton:hover { background: rgba(255,255,255,0.07); color: $sidebar_active_text; }
#NavButton:checked {
  background: $nav_active; color: $sidebar_active_text; font-weight: 700;
}

/* ---- الأزرار (مسطّحة نظيفة) ---- */
QPushButton {
  background: $primary; color: $on_primary; border: none; border-radius: $radius;
  padding: $btn_pad; font-weight: 600;
}
QPushButton:hover { background: $primary_hover; }
QPushButton:pressed { background: $primary_dark; }
QPushButton:disabled { background: $hairline; color: $text_muted; }
QPushButton#Ghost {
  background: transparent; color: $primary; border: 1px solid $primary;
}
QPushButton#Ghost:hover { background: rgba(127,127,127,0.10); }
QPushButton#Accent { background: $accent; color: $on_accent; }
QPushButton#Accent:hover { background: $accent_dark; }
QPushButton#Danger { background: $danger; color: #FFFFFF; }
QPushButton#Success { background: $success; color: #FFFFFF; }

#AppBar QPushButton#Ghost {
  color: $appbar_text; border: 1px solid rgba(255,255,255,0.45); background: transparent;
}
#AppBar QPushButton#Ghost:hover { background: rgba(255,255,255,0.14); }

/* ---- الحقول (مينيمال) ---- */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QPlainTextEdit, QTextEdit {
  background: $input_bg; border: 1px solid $hairline; border-radius: $radius; padding: $pad_v;
  color: $text; selection-background-color: $primary; selection-color: $on_primary;
}
QLineEdit:hover, QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover, QDateEdit:hover {
  border: 1px solid $accent;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus,
QPlainTextEdit:focus, QTextEdit:focus { border: 2px solid $primary; }
QComboBox::drop-down { border: none; width: 24px; }
QComboBox QAbstractItemView {
  background: $surface; border: 1px solid $hairline; border-radius: $radius; outline: none;
  selection-background-color: $primary; selection-color: $on_primary; padding: 4px;
}
QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button { width: 20px; }

/* ---- البطاقات الزجاجية ---- */
#Card {
  background: $glass_bg; border: 1px solid $glass_border; border-radius: $radius_lg;
}
#StatCard {
  background: $glass_bg; border: 1px solid $glass_border; border-radius: $radius_lg;
  border-right: 3px solid $stat_accent;
}
#StatValue { font-size: $stat_value_size; font-weight: 800; color: $stat_accent; }
#StatLabel { color: $text_muted; font-weight: 600; }
#Title { font-size: $title_size; font-weight: 800; color: $text; }
#Heading { font-size: $heading_size; font-weight: 700; color: $text; }
#Muted { color: $text_muted; }

/* ---- الجداول (مينيمال) ---- */
QTableWidget, QTableView {
  background: $glass_bg; border: 1px solid $glass_border; border-radius: $radius;
  gridline-color: $hairline; alternate-background-color: rgba(127,127,127,0.05);
}
QHeaderView::section {
  background: transparent; color: $text_muted; padding: 11px; border: none;
  border-bottom: 1px solid $hairline; font-weight: 700;
}
QHeaderView::section:hover { color: $primary; }
QTableWidget::item, QTableView::item { padding: 6px; }
QTableWidget::item:selected, QTableView::item:selected { background: $primary; color: $on_primary; }
QTableCornerButton::section { background: transparent; border: none; }

/* ---- التبويبات (مينيمال) ---- */
QTabWidget::pane { border: 1px solid $glass_border; border-radius: $radius_lg; top: -1px; background: $glass_bg; }
QTabBar::tab {
  background: transparent; color: $text_muted; padding: 10px 22px;
  border: none; border-bottom: 2px solid transparent; margin-left: 4px; font-weight: 700;
}
QTabBar::tab:hover { color: $text; }
QTabBar::tab:selected { color: $primary; border-bottom: 2px solid $primary; }

/* ---- أشرطة التمرير (رفيعة هادئة) ---- */
QScrollBar:vertical { background: transparent; width: 11px; margin: 2px; }
QScrollBar::handle:vertical { background: $hairline; border-radius: 5px; min-height: 36px; }
QScrollBar::handle:vertical:hover { background: $accent; }
QScrollBar:horizontal { background: transparent; height: 11px; margin: 2px; }
QScrollBar::handle:horizontal { background: $hairline; border-radius: 5px; min-width: 36px; }
QScrollBar::handle:horizontal:hover { background: $accent; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

/* ---- متفرقات ---- */
QToolTip { background: $surface; color: $text; border: 1px solid $hairline; padding: 6px; border-radius: 6px; }
QCheckBox::indicator, QRadioButton::indicator { width: 18px; height: 18px; }
QCheckBox::indicator:checked { background: $primary; border-radius: 4px; }
QProgressBar { border: 1px solid $hairline; border-radius: $radius; background: rgba(127,127,127,0.10); text-align: center; }
QProgressBar::chunk {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 $primary, stop:1 $accent);
  border-radius: $radius;
}
QMessageBox, QDialog { background: $surface; }
QMenu { background: $surface; color: $text; border: 1px solid $hairline; border-radius: $radius; padding: 4px; }
QMenu::item { padding: 7px 22px; border-radius: 5px; }
QMenu::item:selected { background: $primary; color: $on_primary; }

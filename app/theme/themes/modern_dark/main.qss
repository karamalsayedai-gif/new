/* ============================================================
   ستايل محاسبي/كاشير تقليدي مألوف — مسطّح بإطارات واضحة
   ألوان محايدة، تباين عالٍ، جداول كثيفة. كل القيم من توكنز القالب.
   ============================================================ */
* { font-family: "$font"; font-size: $base_size; outline: none; }
QWidget { background: $bg; color: $text; }
QLabel { background: transparent; }
QMainWindow, QDialog { background: $bg; }
QScrollArea { border: none; background: transparent; }
QScrollArea > QWidget > QWidget { background: transparent; }
#PageRoot, #BodyRoot, #Toolbar { background: transparent; }

/* ---- الشريط العلوي (لون صلب رسمي) ---- */
#AppBar { background: $appbar_bg; border-bottom: 1px solid $border; }
#AppTitle { color: $appbar_text; font-size: 17px; font-weight: 700; }
#UserChip {
  background: transparent; color: $appbar_text;
  border: 1px solid $appbar_text; border-radius: 3px;
  padding: 5px 12px; font-weight: 600;
}

/* ---- القائمة الجانبية (لوحة تنقّل تقليدية) ---- */
#Sidebar { background: $sidebar_bg; border-left: 1px solid $border; }
#SidebarScroll, #SidebarScroll > QWidget > QWidget { background: transparent; }
#SidebarBrand {
  color: $sidebar_active_text; font-size: 14px; font-weight: 700;
  padding: 14px 12px 10px 12px;
  border-bottom: 1px solid rgba(255,255,255,0.12);
}
#NavButton {
  text-align: right; padding: $nav_pad; border: none; border-radius: $radius;
  color: $sidebar_text; background: transparent; margin: 1px 6px; font-weight: 600;
}
#NavButton:hover { background: rgba(255,255,255,0.10); color: $sidebar_active_text; }
#NavButton:checked {
  background: $sidebar_active_bg; color: $sidebar_active_text; font-weight: 700;
}

/* ---- الأزرار (مسطّحة بإطار واضح) ---- */
QPushButton {
  background: $primary; color: $on_primary; border: 1px solid $primary_dark;
  border-radius: $radius; padding: $btn_pad; font-weight: 600;
}
QPushButton:hover { background: $primary_hover; }
QPushButton:pressed { background: $primary_dark; }
QPushButton:disabled { background: $surface_alt; color: $text_muted; border: 1px solid $border; }
QPushButton#Ghost {
  background: $surface; color: $text; border: 1px solid $border;
}
QPushButton#Ghost:hover { background: $surface_alt; }
QPushButton#Accent { background: $accent; color: $on_accent; border: 1px solid $accent_dark; }
QPushButton#Accent:hover { background: $accent_dark; }
QPushButton#Danger { background: $danger; color: #FFFFFF; border: 1px solid $danger; }
QPushButton#Danger:hover { background: $danger; }
QPushButton#Success { background: $success; color: #FFFFFF; border: 1px solid $success; }

#AppBar QPushButton#Ghost {
  background: transparent; color: $appbar_text; border: 1px solid $appbar_text;
}
#AppBar QPushButton#Ghost:hover { background: rgba(255,255,255,0.12); }

/* ---- الحقول (مربّعة واضحة) ---- */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QPlainTextEdit, QTextEdit {
  background: $input_bg; border: 1px solid $border; border-radius: $radius; padding: $pad_v;
  color: $text; selection-background-color: $primary; selection-color: $on_primary;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus,
QPlainTextEdit:focus, QTextEdit:focus { border: 1px solid $primary; }
QComboBox::drop-down { border: none; width: 22px; }
QComboBox QAbstractItemView {
  background: $surface; border: 1px solid $border; outline: none;
  selection-background-color: $primary; selection-color: $on_primary;
}
QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button { width: 18px; }

/* ---- اللوحات/البطاقات (إطار صلب بلا ظل) ---- */
#Card {
  background: $surface; border: 1px solid $border; border-radius: $radius;
}
#StatCard {
  background: $surface; border: 1px solid $border; border-radius: $radius;
  border-top: 3px solid $stat_accent;
}
#StatValue { font-size: $stat_value_size; font-weight: 800; color: $stat_accent; }
#StatLabel { color: $text_muted; font-weight: 700; }
#Title { font-size: $title_size; font-weight: 800; color: $text; }
#Heading { font-size: $heading_size; font-weight: 700; color: $text; }
#Muted { color: $text_muted; }

/* ---- الجداول (كلاسيكية: رأس صلب + خطوط شبكة + تظليل صفوف) ---- */
QTableWidget, QTableView {
  background: $surface; border: 1px solid $border; border-radius: 0;
  gridline-color: $border; alternate-background-color: $surface_alt;
}
QHeaderView::section {
  background: $surface_alt; color: $text; padding: 8px; border: 0;
  border-bottom: 1px solid $border; border-left: 1px solid $border; font-weight: 700;
}
QHeaderView::section:hover { background: $primary; color: $on_primary; }
QTableWidget::item, QTableView::item { padding: 5px; border: 0; }
QTableWidget::item:selected, QTableView::item:selected { background: $primary; color: $on_primary; }
QTableCornerButton::section { background: $surface_alt; border: 1px solid $border; }

/* ---- التبويبات (كلاسيكية) ---- */
QTabWidget::pane { border: 1px solid $border; top: -1px; background: $surface; }
QTabBar::tab {
  background: $surface_alt; color: $text_muted; padding: 8px 18px;
  border: 1px solid $border; border-bottom: none; margin-left: 2px; font-weight: 700;
}
QTabBar::tab:selected { background: $surface; color: $primary; }

/* ---- أشرطة التمرير (كلاسيكية) ---- */
QScrollBar:vertical { background: $surface_alt; width: 14px; margin: 0; border-left: 1px solid $border; }
QScrollBar::handle:vertical { background: $border; border-radius: 0; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: $text_muted; }
QScrollBar:horizontal { background: $surface_alt; height: 14px; margin: 0; border-top: 1px solid $border; }
QScrollBar::handle:horizontal { background: $border; border-radius: 0; min-width: 30px; }
QScrollBar::handle:horizontal:hover { background: $text_muted; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

/* ---- متفرقات ---- */
QToolTip { background: $surface; color: $text; border: 1px solid $border; padding: 5px; }
QCheckBox::indicator, QRadioButton::indicator { width: 16px; height: 16px; }
QCheckBox::indicator:checked { background: $primary; border: 1px solid $primary_dark; }
QProgressBar { border: 1px solid $border; border-radius: 0; background: $surface_alt; text-align: center; }
QProgressBar::chunk { background: $primary; }
QMessageBox, QDialog { background: $surface; }
QMenu { background: $surface; color: $text; border: 1px solid $border; }
QMenu::item { padding: 6px 20px; }
QMenu::item:selected { background: $primary; color: $on_primary; }

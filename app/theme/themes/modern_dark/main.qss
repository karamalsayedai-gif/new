/* ===== عصري داكن — تصميم مسطّح بلمسة جانبية، شريط جانبي يسار ===== */
* { font-family: "$font"; font-size: $base_size; }
QWidget { background: $bg; color: $text; }
QMainWindow, QDialog { background: $bg; }

#AppBar { background: $appbar_bg; border-bottom: 1px solid $border; }
#AppBar QLabel { color: $appbar_text; }
#AppTitle { color: $appbar_text; font-size: 17px; font-weight: bold; }

#Sidebar { background: $sidebar_bg; border-right: 1px solid $border; }
#SidebarBrand { color: $primary; font-size: 16px; font-weight: bold; padding: 16px; }
#NavButton {
    text-align: right; padding: $nav_pad; border: none;
    border-right: 3px solid transparent; border-radius: 0;
    color: $sidebar_text; background: transparent;
}
#NavButton:hover { background: $surface_alt; color: $text; }
#NavButton:checked { background: $sidebar_active_bg; color: $sidebar_active_text; border-right: 3px solid $primary; font-weight: bold; }

QPushButton {
    background: $primary; color: $on_primary; border: none; border-radius: $radius;
    padding: $btn_pad; font-weight: bold;
}
QPushButton:hover { background: $primary_hover; }
QPushButton:disabled { background: $border; color: $text_muted; }
QPushButton#Ghost { background: transparent; color: $text; border: 1px solid $border; }
QPushButton#Danger { background: $danger; color: #FFFFFF; }

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QPlainTextEdit, QTextEdit {
    background: $input_bg; border: 1px solid $border; border-radius: $radius;
    padding: $pad_v; color: $text; selection-background-color: $primary;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus { border: 1px solid $primary; }

#Card { background: $surface; border: 1px solid $border; border-radius: $radius_lg; }
#StatCard { background: $surface; border: 1px solid $border; border-radius: $radius_lg; }
#StatValue { font-size: $stat_value_size; font-weight: bold; color: $stat_accent; }
#StatLabel { color: $text_muted; }
#Title { font-size: $title_size; font-weight: bold; color: $text; }
#Heading { font-size: $heading_size; font-weight: bold; color: $text; }
#Muted { color: $text_muted; }

QTableWidget, QTableView {
    background: $surface; border: 1px solid $border; border-radius: $radius;
    gridline-color: $border;
}
QHeaderView::section { background: $surface_alt; color: $text_muted; padding: 9px; border: none; }
QTableWidget::item:selected, QTableView::item:selected { background: $primary; color: $on_primary; }

/* ===== تلميع مشترك (RC1) ===== */
QPushButton:pressed { padding-top: 1px; }
QComboBox::drop-down { border: none; width: 22px; }
QComboBox QAbstractItemView {
    background: $surface; border: 1px solid $border;
    selection-background-color: $primary; selection-color: $on_primary;
    outline: none;
}
QScrollBar:vertical { background: transparent; width: 11px; margin: 2px; }
QScrollBar::handle:vertical { background: $border; border-radius: 5px; min-height: 28px; }
QScrollBar::handle:vertical:hover { background: $text_muted; }
QScrollBar:horizontal { background: transparent; height: 11px; margin: 2px; }
QScrollBar::handle:horizontal { background: $border; border-radius: 5px; min-width: 28px; }
QScrollBar::handle:horizontal:hover { background: $text_muted; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QTabWidget::pane { border: 1px solid $border; border-radius: $radius; top: -1px; }
QTabBar::tab {
    background: $surface_alt; color: $text_muted; padding: 8px 18px;
    border-top-left-radius: $radius; border-top-right-radius: $radius; margin-left: 2px;
}
QTabBar::tab:selected { background: $primary; color: $on_primary; }
QHeaderView::section:hover { background: $primary; color: $on_primary; }
QTableWidget { alternate-background-color: $surface_alt; }
QToolTip { background: $surface; color: $text; border: 1px solid $border; padding: 4px; }
QCheckBox::indicator, QRadioButton::indicator { width: 16px; height: 16px; }
QMessageBox, QDialog { background: $bg; }
QMenu { background: $surface; color: $text; border: 1px solid $border; }
QMenu::item:selected { background: $primary; color: $on_primary; }
QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button { width: 16px; }
#SidebarBrand { padding-bottom: 6px; }
